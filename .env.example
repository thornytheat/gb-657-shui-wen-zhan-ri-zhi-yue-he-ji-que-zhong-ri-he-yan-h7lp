# 主服务在容器内的 SQLite 路径（挂载命名卷 meterback-data）
METERBACK_DB=/data/meterback.sqlite
# 样例目录：容器内为 /app/sample_data，本地直接运行时用 ./sample_data
METERBACK_SAMPLE_DIR=./sample_data

# M8 预警派单独立 SQLite（与主库分开）
DISPATCH_DB=/data/dispatch.sqlite
# 月雨量警戒线（mm）：月量 >= 阈值预警，严格小于才撤警
RAIN_WARN_THRESHOLD_MM=300.0
# 按站覆盖警戒线（JSON，可选）
# RAIN_WARN_STATION_THRESHOLDS={"0012":250.0}

